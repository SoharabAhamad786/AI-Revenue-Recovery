# RecoverAI Environment Variables
# Copy this file to .env and fill in values

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=recoverai-dev-secret-key-change-in-production

# JWT
JWT_SECRET_KEY=recoverai-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Database
DATABASE_URL=sqlite:///recoverai.db

# AI Service (optional - leave empty for mock AI mode)
AI_PROVIDER=mock
# AI_PROVIDER=openai
# AI_PROVIDER=gemini

# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Recovery Settings
HIGH_VALUE_THRESHOLD=10000
REMINDER_COOLDOWN_HOURS=48
MAX_AUTO_REMINDER_AMOUNT=5000

# CORS
FRONTEND_URL=http://localhost:5173
